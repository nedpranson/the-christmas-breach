package home

import "github.com/nedpranson/the-christmas-breach/templates/base"

templ Home() {
    @base.Layout(base.LayoutProps{
        Title: "The Christmas Breach",
        Class: "bg-background text-foreground",
    }) {
		<h1>Hello World!</h1>
		<pre class="flex flex-col items-start">
            <a href="/level/1" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                         *             1" }
            </a>
            <a href="/level/2" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                                 *     2" }
            </a>
            <a href="/level/3" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                                    *  3" }
            </a>
            <a href="/level/4" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                        *              4" }
            </a>
            <a href="/level/5" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "              *                        5" }
            </a>
            <a href="/level/6" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "        *                              6" }
            </a>
            <a href="/level/7" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                 *                     7" }
            </a>
            <a href="/level/8" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "      *                                8" }
            </a>
            <a href="/level/9" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "            *                          9" }
            </a>
            <a href="/level/10" class="px-4 outline-none hover:bg-selection-background focus:bg-selection-background">
                { "                      *               10" }
            </a>
        </pre>
	}
}
