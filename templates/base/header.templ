package base

templ Header() {
    <nav class="flex justify-between border-b py-3 px-8 font-semibold">
        <div>
            <a 
                href="/"
                class="outline-none text-primary hover:text-selection-primary focus:text-selection-primary"
            >
                [ The Christmas Breach ]
            </a>
        </div>
        <div>
            <a
                href="/log-in"
                class="px-2 py-0.5 outline-none text-background bg-primary hover:bg-selection-primary focus:bg-selection-primary"
            >
                [Log In]
            </a>
        </div>
    </nav>
}
