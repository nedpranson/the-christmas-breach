package base

type LayoutProps struct {
	Title string
	Class string
}

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link
				href="/assets/fonts/source-code-pro-latin.woff2"
				rel="preload"
				as="font"
				type="font/woff2"
				crossorigin
			/>
			<link href="/assets/css/global.css" rel="stylesheet"/>
		</head>
		<body class="bg-background text-foreground space-y-6">
			<script>/* prevents firefox from force loading html */</script>
            @Header()
			<main
				if props.Class != "" {
					class={ props.Class }
				}
			>
				{ children... }
			</main>
		</body>
	</html>
}
