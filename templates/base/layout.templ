package base

type LayoutProps struct {
	Title string
	Class string
}

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link href="/assets/css/global.css" rel="stylesheet"/>
		</head>
		<body>
			<script>/* prevents firefox from force loading html */</script>
			<main
				if props.Class != "" {
					class={ props.Class }
				}
			>
				{ children... }
			</main>
		</body>
	</html>
}
