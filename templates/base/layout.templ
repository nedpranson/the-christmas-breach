package base

import "github.com/nedpranson/the-christmas-breach/core/util"

type LayoutProps struct {
	Title string
	Class string
}

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=0.75"/>
			<title>{ props.Title }</title>
			<link
				href="/assets/fonts/jetbrains-mono.woff2"
				rel="preload"
				as="font"
				type="font/woff2"
				crossorigin
			/>
			<link href="/assets/css/global.css" rel="stylesheet"/>
		</head>
		<body class="space-y-6 bg-background text-foreground max-w-4xl mx-auto">
			<script>/* prevents firefox from force loading html */</script>
            @Header()
			<main class={ util.TwMerge("px-8", props.Class) } >
				{ children... }
			</main>
		</body>
	</html>
}
