package base

import (
    "fmt"
    "strconv"
    "net/http"
)

type ErrorProps struct {
    Message string
    Status  int
}

templ Error(props ErrorProps) {
	@Layout(LayoutProps{
		Title: fmt.Sprintf("%d - %s", props.Status, http.StatusText(props.Status)),
		Class: "flex flex-col items-center bg-stone-100 text-center",
	}) {
        <h1 class="mt-24 bg-[repeating-linear-gradient(45deg,var(--color-gray-400)_0px,var(--color-gray-400)_10px,var(--color-gray-300)_10px,var(--color-gray-300)_20px)] bg-clip-text text-[12rem] leading-none font-bold text-transparent">
            { strconv.Itoa(props.Status) }
        </h1>
        <p class="max-w-md text-lg text-stone-700">
            { props.Message }
        </p>
	}
}

templ ErrorNotFound() {
    @Error(ErrorProps{
        Message: "The page you're looking for doesn't exist, has been removed, or you don't have permission to access it.",
        Status: http.StatusNotFound,
    })
}

templ ErrorInternalServer() {
    @Error(ErrorProps{
        Message: "An internal server error occurred. Please try again later.",
        Status: http.StatusInternalServerError,
    })
}
